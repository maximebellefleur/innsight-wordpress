{
    "version": 8,
    "name": "Innsight Cream",
    "metadata": {
        "innsight:palette": {
            "bg":    "#EFE8D8",
            "block": "#E4DBC4",
            "road":  "#FBF7EC",
            "park":  "#CFE48E",
            "water": "#B5DDD3",
            "label": "#8B8164"
        }
    },
    "sources": {
        "composite": {
            "type": "vector",
            "url": "mapbox://mapbox.mapbox-streets-v8"
        }
    },
    "sprite": "mapbox://sprites/mapbox/light-v11",
    "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": { "background-color": "#EFE8D8" }
        },
        {
            "id": "landuse-park",
            "type": "fill",
            "source": "composite",
            "source-layer": "landuse",
            "filter": ["any",
                ["==", ["get", "class"], "park"],
                ["==", ["get", "class"], "pitch"],
                ["==", ["get", "class"], "cemetery"],
                ["==", ["get", "class"], "grass"]
            ],
            "paint": { "fill-color": "#CFE48E" }
        },
        {
            "id": "landuse-residential",
            "type": "fill",
            "source": "composite",
            "source-layer": "landuse",
            "filter": ["==", ["get", "class"], "residential"],
            "paint": { "fill-color": "#E4DBC4", "fill-opacity": 0.6 }
        },
        {
            "id": "water",
            "type": "fill",
            "source": "composite",
            "source-layer": "water",
            "paint": { "fill-color": "#B5DDD3" }
        },
        {
            "id": "waterway",
            "type": "line",
            "source": "composite",
            "source-layer": "waterway",
            "paint": {
                "line-color": "#B5DDD3",
                "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.4, 18, 2]
            }
        },
        {
            "id": "building",
            "type": "fill",
            "source": "composite",
            "source-layer": "building",
            "minzoom": 13,
            "paint": {
                "fill-color": "#E4DBC4",
                "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 0.5, 15, 0.85]
            }
        },
        {
            "id": "road-path",
            "type": "line",
            "source": "composite",
            "source-layer": "road",
            "filter": ["any",
                ["==", ["get", "class"], "path"],
                ["==", ["get", "class"], "pedestrian"]
            ],
            "paint": {
                "line-color": "#E4DBC4",
                "line-width": 1,
                "line-dasharray": [1, 1]
            }
        },
        {
            "id": "road-street",
            "type": "line",
            "source": "composite",
            "source-layer": "road",
            "filter": ["any",
                ["==", ["get", "class"], "street"],
                ["==", ["get", "class"], "street_limited"],
                ["==", ["get", "class"], "service"]
            ],
            "layout": { "line-cap": "butt", "line-join": "miter" },
            "paint": {
                "line-color": "#FBF7EC",
                "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.4, 16, 2, 18, 6, 20, 14]
            }
        },
        {
            "id": "road-secondary",
            "type": "line",
            "source": "composite",
            "source-layer": "road",
            "filter": ["any",
                ["==", ["get", "class"], "secondary"],
                ["==", ["get", "class"], "tertiary"]
            ],
            "layout": { "line-cap": "butt", "line-join": "miter" },
            "paint": {
                "line-color": "#FBF7EC",
                "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 14, 2.5, 16, 6, 18, 14, 20, 24]
            }
        },
        {
            "id": "road-primary",
            "type": "line",
            "source": "composite",
            "source-layer": "road",
            "filter": ["any",
                ["==", ["get", "class"], "primary"],
                ["==", ["get", "class"], "trunk"],
                ["==", ["get", "class"], "motorway"]
            ],
            "layout": { "line-cap": "butt", "line-join": "miter" },
            "paint": {
                "line-color": "#FBF7EC",
                "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.5, 14, 6, 16, 12, 18, 22, 20, 38]
            }
        },
        {
            "id": "road-label",
            "type": "symbol",
            "source": "composite",
            "source-layer": "road",
            "minzoom": 13,
            "filter": ["all",
                ["has", "name"],
                ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "street"], true, false]
            ],
            "layout": {
                "symbol-placement": "line",
                "text-field": ["upcase", ["coalesce", ["get", "name_en"], ["get", "name"]]],
                "text-font": ["Open Sans Bold", "Arial Unicode MS Bold"],
                "text-size": ["interpolate", ["linear"], ["zoom"], 13, 9, 18, 13],
                "text-letter-spacing": 0.08,
                "text-max-angle": 30
            },
            "paint": {
                "text-color": "#8B8164",
                "text-halo-color": "#EFE8D8",
                "text-halo-width": 1.2
            }
        },
        {
            "id": "place-park",
            "type": "symbol",
            "source": "composite",
            "source-layer": "poi_label",
            "filter": ["==", ["get", "maki"], "park"],
            "layout": {
                "text-field": ["get", "name"],
                "text-font": ["Open Sans Italic", "Arial Unicode MS Regular"],
                "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 17, 14]
            },
            "paint": {
                "text-color": "#8B8164",
                "text-halo-color": "#CFE48E",
                "text-halo-width": 1.5
            }
        },
        {
            "id": "place-neighborhood",
            "type": "symbol",
            "source": "composite",
            "source-layer": "place_label",
            "filter": ["any",
                ["==", ["get", "type"], "neighbourhood"],
                ["==", ["get", "type"], "suburb"]
            ],
            "layout": {
                "text-field": ["upcase", ["get", "name"]],
                "text-font": ["Open Sans Bold", "Arial Unicode MS Bold"],
                "text-letter-spacing": 0.12,
                "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 15, 13]
            },
            "paint": {
                "text-color": "#8B8164",
                "text-halo-color": "#EFE8D8",
                "text-halo-width": 1.4
            }
        }
    ]
}
